[
    uuid(3644e25e-9e69-4647-a5ec-8f6d39c3f720),
    version(1.0),
    implicit_handle(handle_t AntivirusBinding)
]
interface AntivirusRpc
{
    void RequestServiceStop(void);
    long GetAuthenticationState(
        [out] long* isAuthenticated,
        [in] long usernameCapacity,
        [out, string, size_is(usernameCapacity)] wchar_t* username,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long LoginUser(
        [string, in] wchar_t* username,
        [string, in] wchar_t* password,
        [out] long* isAuthenticated,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long LogoutUser(
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long GetLicenseState(
        [out] long* licenseState,
        [in] long expirationCapacity,
        [out, string, size_is(expirationCapacity)] wchar_t* expirationDate,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long ActivateProduct(
        [string, in] wchar_t* activationCode,
        [out] long* licenseState,
        [in] long expirationCapacity,
        [out, string, size_is(expirationCapacity)] wchar_t* expirationDate,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long GetAvDatabaseInfo(
        [out] long* isLoaded,
        [out] long* recordCount,
        [in] long releaseDateCapacity,
        [out, string, size_is(releaseDateCapacity)] wchar_t* releaseDate,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long ScanFilePath(
        [string, in] wchar_t* path,
        [out] long* isMalicious,
        [out] long* scannedCount,
        [out] long* detectedCount,
        [in] long summaryCapacity,
        [out, string, size_is(summaryCapacity)] wchar_t* summary
    );
    long ScanDirectoryPath(
        [string, in] wchar_t* path,
        [out] long* hasDetections,
        [out] long* scannedCount,
        [out] long* detectedCount,
        [in] long summaryCapacity,
        [out, string, size_is(summaryCapacity)] wchar_t* summary
    );
    long ScanFixedDrives(
        [out] long* hasDetections,
        [out] long* scannedCount,
        [out] long* detectedCount,
        [in] long summaryCapacity,
        [out, string, size_is(summaryCapacity)] wchar_t* summary
    );
    long ConfigureScheduledScan(
        [in] long isEnabled,
        [in] long intervalSeconds,
        [string, in] wchar_t* targetPath,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long GetScheduledScanState(
        [out] long* isEnabled,
        [out] long* intervalSeconds,
        [in] long targetCapacity,
        [out, string, size_is(targetCapacity)] wchar_t* targetPath,
        [in] long nextRunCapacity,
        [out, string, size_is(nextRunCapacity)] wchar_t* nextRunText,
        [in] long lastRunCapacity,
        [out, string, size_is(lastRunCapacity)] wchar_t* lastRunText,
        [out] long* lastResultCode,
        [in] long summaryCapacity,
        [out, string, size_is(summaryCapacity)] wchar_t* lastSummary
    );
    long AddMonitoredDirectory(
        [string, in] wchar_t* path,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long RemoveMonitoredDirectory(
        [string, in] wchar_t* path,
        [in] long messageCapacity,
        [out, string, size_is(messageCapacity)] wchar_t* message
    );
    long GetMonitoringState(
        [in] long directoriesCapacity,
        [out, string, size_is(directoriesCapacity)] wchar_t* directories,
        [in] long eventsCapacity,
        [out, string, size_is(eventsCapacity)] wchar_t* events
    );
}
